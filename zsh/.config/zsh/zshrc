# ~/.config/zsh/zshrc — zsh interactive shell config

# ── Keymap (emacs mode: Ctrl+A/P/E/N etc.) ────────────────
bindkey -e

# ── Prompt (starship) ────────────────────────────────────
eval "$(starship init zsh)"

# ── History ──────────────────────────────────────────────
export HISTSIZE=5000
export SAVEHIST=5000
export HISTFILE=~/.zsh_history
setopt APPEND_HISTORY         # 多会话共享历史
setopt INC_APPEND_HISTORY     # 实时写入（不等退出）
setopt SHARE_HISTORY          # 跨会话即时共享

# ── Aliases ──────────────────────────────────────────────
# ls: platform-aware color flag
case "$(uname)" in
    Darwin) alias ls='ls -G' ;;
    Linux)  alias ls='ls --color=auto' ;;
esac
alias ll='ls -alFh'
alias la='ls -A'
alias l='ls -CF'
alias grep='rg --color=auto'
alias find='fd'
alias cat='bat -p'
alias reload='source ~/.config/zsh/zshrc && echo "zsh config reloaded"'
alias ..='cd ..'
alias ...='cd ../..'
alias g='git'
alias gs='git status'
alias gl='git log --oneline -20'
alias gd='git diff'
alias df='df -h'
alias du='du -h'
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -i'

# ── Shell options ────────────────────────────────────────
setopt NO_CLOBBER             # > 不覆盖已有文件（反逻辑：setopt NO_xxx = 关闭 clobber = 不覆盖）

# ── Completion ───────────────────────────────────────────
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'  # 忽略大小写

# ── Functions ────────────────────────────────────────────
mcd() { mkdir -p "$1" && cd "$1"; }

# ── fzf ──────────────────────────────────────────────────
[[ -f ~/.config/zsh/fzf.zsh ]] && . ~/.config/zsh/fzf.zsh

# Ctrl+O — fzf pick file and open in nvim
fzf-nvim-widget() {
    local file
    file=$(FZF_DEFAULT_COMMAND='fd --type f' \
        FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border --preview 'bat --color=always --style=numbers,header {} 2>/dev/null || cat {}'" \
        FZF_DEFAULT_OPTS_FILE='' fzf) && nvim "$file"
    zle reset-prompt
}
zle -N fzf-nvim-widget
bindkey '^O' fzf-nvim-widget

# ── lf file manager ──────────────────────────────────────
lfcd() {
    local dir
    dir=$(command lf -print-last-dir "$@" 2>/dev/null) && cd "$dir"
}
alias lf='lfcd'
